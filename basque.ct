## version $VER: VMM-Handler.catalog 1.0 (06.08.2026)
## language euskara
## codeset 0
;
msgNotEnoughMem
Ez dago memoriarik
; Not enough memory
;
msgNoPagingFile
Ezin da orrikatze-fitxategia ireki
; Couldn't open paging file
;
msgNoSpace
Ez dago nahikoa lekurik diskoan
; Not enough space on disk
;
msgFailedIo
Orrikatze-gailurako S/Iak huts egin du
; IO to paging device failed
;
msgFileIsDir
Orrikatze-fitxategia direktorio bat da
; Pagefile is a directory
;
msgInternal
Barne-errorea.\nJarri harremanetan egilearekin: apel@tecmath.de
; Internal error.\nContact author: apel@tecmath.de
;
msgInhibitFailed
Ezin izan da eragotzi DOSek partizioa erabiltzea
; Couldn't inhibit DOS from using partition
;
msgWrongBlocksize
FFS partizioaren bloke-tamaina != 512 byte
; FFS partition with blocksize != 512 bytes
;
msgNoDiskinfo
Ezin da diskoari buruzko informazioa lortu
; Couldn't get information about disk
;
msgNotValidated
Partizioa ez dago balioztatuta
; Partition not validated
;
msgOutOfBounds
Barne-errorea:\nPartizioaren mugetatik kanpoko orri bat atzitzen\nJarri harremanetan egilearekin: apel@tecmath.de
; Internal error:\nAccessing page out of partition bounds\nContact author: apel@tecmath.de
;
msgNoFFS
Pseudo-partizioa ez dago FFS disko batean
; Pseudo partition not on a FFS disk
;
msgNoConfigFile
Ezin da konfigurazio-fitxategia aurkitu.\nErabili GUIko 'Erabili' edo 'Gorde' botoia
; Couldn't find configuration file.\nUse the 'Use' or 'Save' button in the GUI
;
msgCorruptCfgFile
VMM.prefs edo\nVMM_MMU.config hondatuta dago.
; Either VMM.prefs or\nVMM_MMU.config is corrupted.
;
msgVolumeNotFound
Orrikatze-fitxategiaren kokapena baliogabea da\n(Bolumena ez da aurkitu)
; Invalid location of paging file\n(Volume not found)
;
msgLowVersion
Gutxienez sistema eragilearen V37 behar da exekutatzeko
; Need at least V37 of OS to run
;
msgNoDOS
Ezin da dos.library ireki
; Couldn't open dos.library
;
msgNoIntuition
Ezin da intuition.library ireki
; Couldn't open intuition.library
;
msgNoGfx
Ezin da graphics.library ireki
; Couldn't open graphics.library
;
msgNoUtility
Ezin da utility.library ireki
; Couldn't open utility.library
;
msgNoExpansion
Ezin da expansion.library ireki
; Couldn't open expansion.library
;
msgNoCommodities
Ezin da commodities.library ireki
; Couldn't open commodities.library
;
msgWrongCPU
MMU bat behar da programa hau exekutatzeko
; Need a MMU to run this program
;
msgNoAddrSpace
Ezin izan da helbide-espaziorik esleitu\nmemoria birtualerako
; Couldn't allocate address space\nfor virtual memory
;
msgNoPrefs
Ezin da VMM programa nagusia aurkitu
; Couldn't locate VMM main program
;
msgNoStatwindow
Ezin da estatistiken leihoa ireki
; Couldn't open statistics window
;
msgNoRexx
Ezin da rexxsyslib.library ireki
; Couldn't open rexxsyslib.library
;
msgGenericError
%s, %s atazatik:\n%s
; %s from task %s:\n%s
;
msgMessage
Mezu
; Message
;
msgError
Errore
; Error
;
msgOK
Ados
; OK
;
msgReboot
Berrabiarazi
; Reboot
;
msgNoDevice
Ezin da %s ireki
; Couldn't open %s
;
msgNoTimer
Ezin da tenporizadorea abiarazi
; Couldn't initialize timer
;
msgPPTooLarge
Ez dago nahikoa lekurik pseudo-partiziorako.\nGailuan geratzen den lekua %ld MB da
; Not enough space for pseudo-partition.\nSpace left on device is %ld MB
;
msgTooFragmented
Zure disko gogorra zatikatuegia dago\nZati jarraitu handiena %ld MB da.\nAldatu pseudo-partizioaren tamaina edo berrantolatu diskoa
; Your harddisk is too fragmented\nLargest contiguous chunk is %ld MB.\nResize pseudo-partition or reorganize your disk
;
msgVMMLibStillOpen
Ezin da irten. VMM.library oraindik irekita dago
; Can't quit. VMM.library is still opened
;
msgNotEnoughFrames
Ezin da irten. Ez dago nahikoa orri-markorik\noraindik esleitutako memoria gordetzeko.
; Can't quit. Not enough page frames\nto store still allocated memory in.
;
msgStillVMAllocated
Oraindik memoria birtuala dago esleituta\nZati horiek memoria fisikora kargatuko dira\neta VMM itxi egingo da.
; There is still virtual memory allocated\nThese chunks are loaded into physical memory\nand VMM will quit.
;
msgUnusedPartition
%s partizioa ez da oraindik\norrikatzerako erabili. Gainidatzi ?
; Partition %s has not been used\nfor paging yet. Overwrite it ?
;
msgUseCancel
Erabili|Deuseztu
; Use|Cancel
;
msgDeleteFile
%s fitxategia ez da\njarraitua edo tamaina okerra du.\nEzabatu ?
; File %s is not\ncontiguous or has wrong size.\nDelete it ?
;
msgDeleteCancel
Ezabatu|Deuseztu
; Delete|Cancel
;
msgPageDevChanged
Ezin dituzu orrikatze-gailuaren parametroak aldatu\nVMM exekutatzen ari den bitartean. Aldaketek VMMren\nhurrengo abioaren ondoren bakarrik izango dute eragina.
; You cannot change parameter of the paging device\nwhile VMM is running. Your changes will only take\neffect after the next start of VMM.
;
msgVMFree
Memoria birtual librea:
; Virtual memory free:
;
msgPublicFastFree
Public Fast Mem librea:
; Public Fast Mem free:
;
msgNumPF
Orri-hutsegite kopurua:
; Number of pagefaults:
;
msgNumRead
Irakurritako orri kopurua:
; Number of pages read:
;
msgNumWritten
Idatzitako orri kopurua:
; Number of pages written:
;
msgNumFrames
Orri-marko kopurua:
; Number of page frames:
;
msgPagesUsed
Gailuan erabilitako orriak:
; Pages used on device:
;
msgDynMapFailed
Ezin izan da orri-taula instalatu MMU konfigurazio dinamikorako.\nAtaza geldiarazi da.
; Could not install pagetable for dynamic MMU configuration.\nTask stopped.
